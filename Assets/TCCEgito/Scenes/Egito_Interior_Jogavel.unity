  m_Script: {fileID: 11500000, guid: 43dd12635ff14dbfa948e60cebb5924f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrossingTheWorld.TCCEgypt.EgyptStage
  interior: 1
  exteriorScene: Assets/TCCEgito/Scenes/Egito_Exterior_Jogavel.unity
  interiorScene: Assets/TCCEgito/Scenes/Egito_Interior_Jogavel.unity
  scarabVisual: {fileID: 969630877}
  player: {fileID: 1233578670}
  onGuideFinished:
    m_PersistentCalls:
      m_Calls: []
  onScarabReceived:
    m_PersistentCalls:
      m_Calls: []
  onStageCompleted:
    m_PersistentCalls:
      m_Calls: []
  guideLines:
  - speaker: "Guia tur\xEDstico"
    text: "Bem-vinda ao Egito, uma terra onde cada monumento guarda milhares de anos de hist\xF3ria."
  - speaker: "Guia tur\xEDstico"
    text: "As pir\xE2mides e a Esfinge fazem parte do patrim\xF4nio hist\xF3rico deste destino. Nossa ag\xEAncia apresenta esses lugares em seus passeios culturais."
  - speaker: "Guia tur\xEDstico"
    text: "Dentro desta pir\xE2mide vive uma antiga m\xFAmia, guardi\xE3 de um artefato conhecido como Velho Escaravelho."
  - speaker: Amira
    text: "Ent\xE3o a lenda \xE9 verdadeira?"
  - speaker: "Guia tur\xEDstico"
    text: "Ela guarda mem\xF3rias importantes sobre este lugar. Ou\xE7a sua hist\xF3ria com aten\xE7\xE3o."
  mummyLines:
  - speaker: "M\xFAmia"
    text: "H\xE1 milhares de anos, eu vivi nesta terra e acompanhei acontecimentos que hoje se transformaram em hist\xF3rias."
  - speaker: "M\xFAmia"
    text: "Meu corpo foi preparado de acordo com os rituais funer\xE1rios do antigo Egito, para que minha mem\xF3ria fosse preservada."
  - speaker: "M\xFAmia"
    text: "As pir\xE2mides foram erguidas com planejamento, conhecimento de engenharia e o trabalho organizado de muitas pessoas."
  - speaker: "M\xFAmia"
    text: "Os blocos eram transportados e posicionados com t\xE9cnicas desenvolvidas ao longo de muitos anos."
  - speaker: Amira
    text: "Quero conhecer este lugar com respeito e aprender com suas hist\xF3rias."
  - speaker: "M\xFAmia"
    text: "Voc\xEA demonstrou respeito e curiosidade. Por isso, pode levar o Velho Escaravelho como lembran\xE7a desta jornada."
  - speaker: Amira
    text: "Coragem n\xE3o significa enfrentar tudo sozinha. \xC0s vezes, confiar nas pessoas \xE9 o que nos leva mais longe."
